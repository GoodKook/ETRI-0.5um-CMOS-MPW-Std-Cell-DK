//
// Filename: cloud.v
// Purpose:
//
`include "dino_run.vh"

module cloud(clk, reset, x_pos, y_pos, v_sync, alt, en_alt, pixel);
input       clk;
input       reset;
input [6:0] x_pos;
input [5:0] y_pos;
input       v_sync;
input [3:0] alt;
output      en_alt;
output      pixel;

    // Update Cloud position -----------------------------------------
    reg [6:0]   _x_cloud[2];
    reg         sel_cloud;
    reg         en_alt;
    reg [3:0]   _alt[2];
    always @(posedge clk or posedge reset)
    begin
        if (reset)
        begin
            _x_cloud[0] <= 0;
            _x_cloud[1] <= 0;
            sel_cloud <= 0;
        end
        else
        begin
            if (v_sync)
            begin
                if (_x_cloud[0]==0)
                begin
                    _alt[1] <= alt + 4;
                    _alt[0] <= alt;
                    en_alt <= 1;
                end
                else
                    en_alt <= 0;

                _x_cloud[0] <= _x_cloud[0] + 1;
                _x_cloud[1] <= _x_cloud[1] + 2;
                sel_cloud <= ~sel_cloud;
            end
        end
    end

    wire [6:0]   x_cloud;
    wire [3:0]   alt_cloud;
    assign x_cloud   = (sel_cloud)? _x_cloud[1] : _x_cloud[0];
    assign alt_cloud = (sel_cloud)? _alt[1] : _alt[0];

    // Cloud Image ROM -----------------------------------------------
    reg  [`CLOUD_W-1:0]  rom_data;
    always @*
    begin                         //          1         2         3
        case(rom_addr)            //01234567890123456789012345678901
            3'b000 : rom_data = 32'b00000000000000000011100000000000;
            3'b001 : rom_data = 32'b00000000011000000100011000000000;
            3'b010 : rom_data = 32'b00000000100010011000000100000000;
            3'b011 : rom_data = 32'b00000001000000100000000011000000;
            3'b100 : rom_data = 32'b00000010000000000000000000100000;
            3'b101 : rom_data = 32'b00000100000000000000000000010000;
            3'b110 : rom_data = 32'b00011000000110011000001100001000;
            3'b111 : rom_data = 32'b01111111111001100011110011100000;
        endcase
    end

    // Cloud rom address ---------------------------------------------
    wire [2:0]  rom_addr;
    assign rom_addr = y_pos - alt_cloud;

    // Cloud rom bit-position ----------------------------------------
    reg pixel;
    always @*
    begin
        if ((x_cloud>2) && (x_pos>x_cloud) && (x_pos<(x_cloud+`CLOUD_W)) && (y_pos>=alt_cloud) && (y_pos<(alt_cloud+`CLOUD_H)))
            pixel = rom_data[x_pos-x_cloud];
        else
            pixel = 0;
    end
endmodule
