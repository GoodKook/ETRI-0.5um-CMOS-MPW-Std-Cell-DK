    - clkbuf_1_0__f_clk CLKBUFX4 + SOURCE TIMING + PLACED ( 16000 180000 ) N ;
    - clkbuf_1_1__f_clk CLKBUFX4 + SOURCE TIMING + PLACED ( 272000 144000 ) FS ;
END COMPONENTS
PINS 13 ;
    - VDD + NET VDD + SPECIAL + DIRECTION INOUT + USE POWER
      + PORT
        + LAYER MET3 ( -144000 -1000 ) ( 144000 1000 )
        + LAYER MET3 ( -144000 -73000 ) ( 144000 -71000 )
        + LAYER MET3 ( -144000 -145000 ) ( 144000 -143000 )
