VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN shift_reg_8bit ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 326400 294000 ) ;
ROW ROW_0 core 17600 37500 N DO 90 BY 1 STEP 3200 0 ;
ROW ROW_1 core 17600 73500 FS DO 90 BY 1 STEP 3200 0 ;
ROW ROW_2 core 17600 109500 N DO 90 BY 1 STEP 3200 0 ;
ROW ROW_3 core 17600 145500 FS DO 90 BY 1 STEP 3200 0 ;
ROW ROW_4 core 17600 181500 N DO 90 BY 1 STEP 3200 0 ;
ROW ROW_5 core 17600 217500 FS DO 90 BY 1 STEP 3200 0 ;
TRACKS Y 0 DO 96 STEP 3000 LAYER MET1 ;
TRACKS X 0 DO 100 STEP 3200 LAYER MET2 ;
TRACKS Y 0 DO 95 STEP 3000 LAYER MET3 ;
VIAS 1 ;
- via1_2_2000_2000_1_1_1600_1600
+ RECT MET1 ( -1000 -1000 ) ( 1000 1000 )
+ RECT VIA1 ( -400 -400 ) ( 400 400 )
+ RECT MET2 ( -1000 -1000 ) ( 1000 1000 ) ;
END VIAS
COMPONENTS 19 ;
    - _10_ TIEHIX1 + PLACED ( 158400 109500 ) N ;
    - _11_ TIEHIX1 + PLACED ( 190400 109500 ) N ;
    - _12_ TIEHIX1 + PLACED ( 264000 145500 ) FS ;
    - _13_ TIEHIX1 + PLACED ( 235200 217500 ) FS ;
    - _14_ TIEHIX1 + PLACED ( 299200 181500 ) N ;
    - _15_ TIEHIX1 + PLACED ( 52800 181500 ) N ;
    - _16_ DFFSRX1 + PLACED ( 62400 145500 ) FS ;
