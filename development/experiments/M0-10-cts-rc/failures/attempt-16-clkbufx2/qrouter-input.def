    - _22_ DFFSRX1 + PLACED ( 62400 73500 ) FS ;
    - _23_ DFFSRX1 + PLACED ( 65600 181500 ) N ;
    - _8_ TIEHIX1 + PLACED ( 94400 217500 ) FS ;
    - _9_ TIEHIX1 + PLACED ( 49600 145500 ) FS ;
    - clkbuf_0_clk CLKBUFX2 + SOURCE TIMING + PLACED ( 136000 181500 ) N ;
    - clkbuf_1_0__f_clk CLKBUFX2 + SOURCE TIMING + PLACED ( 17600 145500 ) FS ;
    - clkbuf_1_1__f_clk CLKBUFX2 + SOURCE TIMING + PLACED ( 267200 181500 ) N ;
END COMPONENTS
PINS 13 ;
    - VDD + NET VDD + DIRECTION INOUT + USE POWER
              + LAYER MET2 ( -1000 -109000 ) ( 1000 109000 )
        + LAYER MET2 ( -77800 -109000 ) ( -75800 109000 )
        + LAYER MET2 ( -154600 -109000 ) ( -152600 109000 )
        + LAYER MET2 ( -231400 -109000 ) ( -229400 109000 )
        + FIXED ( 288000 145500 ) N ;
    - VSS + NET VSS + DIRECTION INOUT + USE GROUND
              + LAYER MET2 ( -1000 -109000 ) ( 1000 109000 )
        + LAYER MET2 ( -77800 -109000 ) ( -75800 109000 )
        + LAYER MET2 ( -154600 -109000 ) ( -152600 109000 )
        + LAYER MET2 ( -231400 -109000 ) ( -229400 109000 )
        + FIXED ( 249600 145500 ) N ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
              + LAYER MET2 ( -500 -3000 ) ( 500 3000 )
        + PLACED ( 195200 288000 ) N ;
    - din + NET din + DIRECTION INPUT + USE SIGNAL
              + LAYER MET2 ( -500 -3000 ) ( 500 3000 )
        + PLACED ( 144000 288000 ) N ;
    - dout[0] + NET dout[0] + DIRECTION OUTPUT + USE SIGNAL
              + LAYER MET2 ( -500 -3000 ) ( 500 3000 )
        + PLACED ( 131200 288000 ) N ;
    - dout[1] + NET dout[1] + DIRECTION OUTPUT + USE SIGNAL
              + LAYER MET2 ( -500 -3000 ) ( 500 3000 )
        + PLACED ( 156800 288000 ) N ;
