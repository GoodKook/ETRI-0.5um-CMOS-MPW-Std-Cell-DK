VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN shift_reg_8bit ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 320000 288000 ) ;
ROW ROW_0 core 16000 36000 N DO 90 BY 1 STEP 3200 0 ;
ROW ROW_1 core 16000 72000 FS DO 90 BY 1 STEP 3200 0 ;
ROW ROW_2 core 16000 108000 N DO 90 BY 1 STEP 3200 0 ;
ROW ROW_3 core 16000 144000 FS DO 90 BY 1 STEP 3200 0 ;
ROW ROW_4 core 16000 180000 N DO 90 BY 1 STEP 3200 0 ;
ROW ROW_5 core 16000 216000 FS DO 90 BY 1 STEP 3200 0 ;
TRACKS X 1500 DO 107 STEP 3000 LAYER MET1 ;
TRACKS Y 1500 DO 96 STEP 3000 LAYER MET1 ;
TRACKS X 1600 DO 100 STEP 3200 LAYER MET2 ;
TRACKS Y 1600 DO 90 STEP 3200 LAYER MET2 ;
TRACKS X 3000 DO 106 STEP 3000 LAYER MET3 ;
TRACKS Y 3000 DO 95 STEP 3000 LAYER MET3 ;
VIAS 1 ;
    - via1_2_2000_2000_1_1_1600_1600 + VIARULE V12 + CUTSIZE 800 800  + LAYERS MET1 VIA1 MET2  + CUTSPACING 800 800  + ENCLOSURE 600 600 600 600  ;
END VIAS
