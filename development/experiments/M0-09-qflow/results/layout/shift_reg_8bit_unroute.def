VERSION 5.6 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN shift_reg_8bit ;
UNITS DISTANCE MICRONS 100 ;

DIEAREA ( -640 -600 ) ( 14080 15300 ) ;

TRACKS Y -600 DO 54 STEP 300 LAYER MET1 ;
TRACKS X -640 DO 47 STEP 320 LAYER MET2 ;
TRACKS Y -600 DO 54 STEP 300 LAYER MET3 ;

VIAS 0 ;
END VIAS

COMPONENTS 16 ;
- _19_ DFFSRX1 + PLACED ( 160 150 ) FS ;
- _12_ TIEHIX1 + PLACED ( 6240 150 ) S ;
- _18_ DFFSRX1 + PLACED ( 6880 150 ) FS ;
- _13_ TIEHIX1 + PLACED ( 12960 150 ) S ;
- _11_ TIEHIX1 + PLACED ( 160 3750 ) N ;
- _20_ DFFSRX1 + PLACED ( 800 3750 ) FN ;
- _14_ TIEHIX1 + PLACED ( 6880 3750 ) N ;
- _17_ DFFSRX1 + PLACED ( 7520 3750 ) FN ;
- _23_ DFFSRX1 + PLACED ( 160 7350 ) FS ;
- _8_ TIEHIX1 + PLACED ( 6240 7350 ) S ;
- _10_ TIEHIX1 + PLACED ( 6880 7350 ) FS ;
- _21_ DFFSRX1 + PLACED ( 7520 7350 ) S ;
- _15_ TIEHIX1 + PLACED ( 160 10950 ) N ;
- _16_ DFFSRX1 + PLACED ( 800 10950 ) FN ;
- _22_ DFFSRX1 + PLACED ( 6880 10950 ) N ;
- _9_ TIEHIX1 + PLACED ( 12960 10950 ) FN ;
END COMPONENTS

PINS 13 ;
- VSS + NET VSS
  + LAYER MET1 ( -480 0 ) ( 480 0 )
  + PLACED ( 14270 50 ) N ;
- VDD + NET VDD
  + LAYER MET1 ( -480 0 ) ( 480 0 )
  + PLACED ( -510 50 ) N ;
- clk + NET clk
  + LAYER MET3 ( -60 -60 ) ( 60 60 )
  + PLACED ( -320 9000 ) N ;
- rst_n + NET rst_n
  + LAYER MET3 ( -60 -60 ) ( 60 60 )
  + PLACED ( -320 9900 ) N ;
- din + NET din
  + LAYER MET2 ( -50 -50 ) ( 50 50 )
  + PLACED ( 3840 15300 ) N ;
- dout[7] + NET dout[7]
  + LAYER MET2 ( -50 -50 ) ( 50 50 )
  + PLACED ( 7680 -300 ) N ;
- dout[6] + NET dout[6]
  + LAYER MET3 ( -60 -60 ) ( 60 60 )
  + PLACED ( 14080 3000 ) N ;
- dout[5] + NET dout[5]
  + LAYER MET2 ( -50 -50 ) ( 50 50 )
  + PLACED ( 8320 -300 ) N ;
- dout[4] + NET dout[4]
  + LAYER MET3 ( -60 -60 ) ( 60 60 )
  + PLACED ( -320 4500 ) N ;
- dout[3] + NET dout[3]
  + LAYER MET2 ( -50 -50 ) ( 50 50 )
  + PLACED ( 7680 15300 ) N ;
- dout[2] + NET dout[2]
  + LAYER MET3 ( -60 -60 ) ( 60 60 )
  + PLACED ( 14080 11700 ) N ;
- dout[1] + NET dout[1]
  + LAYER MET2 ( -50 -50 ) ( 50 50 )
  + PLACED ( 8320 15300 ) N ;
- dout[0] + NET dout[0]
  + LAYER MET3 ( -60 -60 ) ( 60 60 )
  + PLACED ( -320 11700 ) N ;
END PINS

NETS 19 ;
- _2_
  ( _21_ S ) 
  ( _10_ Y ) ;
- _3_
  ( _20_ S ) 
  ( _11_ Y ) ;
- _4_
  ( _19_ S ) 
  ( _12_ Y ) ;
- _5_
  ( _18_ S ) 
  ( _13_ Y ) ;
- _6_
  ( _17_ S ) 
  ( _14_ Y ) ;
- _7_
  ( _16_ S ) 
  ( _15_ Y ) ;
- clk
  ( PIN clk ) 
  ( _23_ CLK ) 
  ( _22_ CLK ) 
  ( _21_ CLK ) 
  ( _20_ CLK ) 
  ( _19_ CLK ) 
  ( _18_ CLK ) 
  ( _17_ CLK ) 
  ( _16_ CLK ) ;
- din
  ( PIN din ) 
  ( _16_ D ) ;
- dout[0]
  ( PIN dout[0] ) 
  ( _23_ D ) 
  ( _16_ Q ) ;
- rst_n
  ( PIN rst_n ) 
  ( _23_ R ) 
  ( _22_ R ) 
  ( _21_ R ) 
  ( _20_ R ) 
  ( _19_ R ) 
  ( _18_ R ) 
  ( _17_ R ) 
  ( _16_ R ) ;
- dout[6]
  ( PIN dout[6] ) 
  ( _18_ Q ) 
  ( _17_ D ) ;
- dout[7]
  ( PIN dout[7] ) 
  ( _17_ Q ) ;
- dout[5]
  ( PIN dout[5] ) 
  ( _19_ Q ) 
  ( _18_ D ) ;
- dout[4]
  ( PIN dout[4] ) 
  ( _20_ Q ) 
  ( _19_ D ) ;
- dout[3]
  ( PIN dout[3] ) 
  ( _21_ Q ) 
  ( _20_ D ) ;
- dout[2]
  ( PIN dout[2] ) 
  ( _22_ Q ) 
  ( _21_ D ) ;
- dout[1]
  ( PIN dout[1] ) 
  ( _23_ Q ) 
  ( _22_ D ) ;
- _1_
  ( _9_ Y ) 
  ( _22_ S ) ;
- _0_
  ( _8_ Y ) 
  ( _23_ S ) ;
END NETS

SPECIALNETS 2 ;
- VSS
+ FIXED MET1 200 ( 13280 10950 ) ( 14270 * )
  NEW MET1 200 ( 13280 3750 ) ( 14270 * )
  NEW MET1 960 ( 14270 50 ) ( * 14650 ) ;
- VDD
+ FIXED MET1 200 ( -510 14550 ) ( 480 * )
  NEW MET1 200 ( -510 7350 ) ( 480 * )
  NEW MET1 200 ( -510 150 ) ( 480 * )
  NEW MET1 960 ( -510 50 ) ( * 14650 ) ;
END SPECIALNETS

END DESIGN
