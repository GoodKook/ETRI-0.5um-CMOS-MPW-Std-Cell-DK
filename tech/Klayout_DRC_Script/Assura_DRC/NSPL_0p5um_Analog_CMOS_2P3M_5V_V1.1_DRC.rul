drcExtractRules(

layerDefs( "GDS2"
  
    CHIPBOUNDARY=layer( 0 type(0) )
 
    KEY=layer( 1 type(0) )

    NWELLi=layer(2 type(0) )

    PWELLi=layer(3 type(0) )

    HNWELLi=layer(4 type(0) )
   
    HPWELLi=layer(5 type(0) )

    DWELLi=layer(6 type(0) )

    DNWELLi=layer(7 type(0) )
    
    DPWELLi=layer(8 type(0) )

    ACTi=layer(11 type(0) )

    POLY1i=layer(12 type(0) )

    POLY2i=layer(13 type(0) )

    NSDi=layer(14 type(0) )

    PSDi=layer(15 type(0) )

    FVTNi=layer(16 type(0) )

    FVTPi=layer(17 type(0) )

    VTNi=layer(18 type(0) )

    VTPi=layer(19 type(0) )

    NHRIi=layer(20 type(0) )

    PHRIi=layer(21 type(0) )

    NPIi=layer(22 type(0) )

    PPIi=layer(23 type(0) )

    NDRIFTi=layer(24 type(0) )

    PDRIFTi=layer(25 type(0) )

    ESDI=layer(26 type(0) )

    TGOXi=layer(27 type(0) )

