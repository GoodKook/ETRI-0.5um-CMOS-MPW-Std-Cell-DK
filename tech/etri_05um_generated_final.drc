#  KLayout DRC Runset for ETRI NSPL 0.5um Analog CMOS 2P3M 5V Process
#  [PART 3/3] Advanced Special Devices & Seal-Ring Integration Rules (Fixed)
# =======================================================================

# =======================================================================
#  KLayout DRC Runset for ETRI NSPL 0.5um Analog CMOS 2P3M 5V Process
#  [PART 3/3] Advanced Special Devices & Seal-Ring Integration Rules (Fixed)
# =======================================================================

# === 4.14 Poly2 Resistor Rules (PL2PR) ===
POLY2.and(RES).width(2.0.um).output("14.PL2PR.W", "14.PL2PR.W: Minimum POLY2 resistor width must be >= 2.0um.")
res_l_edges = PPRES.edges.and(LVSD.edges)
res_l_edges.space(4.0.um).output("14.PL2PR.L", "14.PL2PR.L: Minimum POLY2 resistor length must be >= 4.0um.")
CONT.and(POLY2_RES).space(0.6.um).output("14.PL2PR.S1", "14.PL2PR.S1: Minimum CONT space on Poly2 resistor >= 0.6um.")
POLY2_RES.enclosing(PHRI, 1.0.um).output("14.PL2PR.E1", "14.PL2PR.E1: Minimum extension of Poly2 to PHRI >= 1.0um.")
POLY2_RES.enclosing(CONT, 0.5.um).output("14.PL2PR.E2", "14.PL2PR.E2: Minimum extension of CONT to Poly2 resistor >= 0.5um.")
POLY2_RES.not(RES).output("14.PL2PR.bad1", "14.PL2PR.bad1: POLY2 for resistor must exist inside RES layer.")
POLY1.and(RES).output("14.PL2PR.bad2", "14.PL2PR.bad2: POLY1 cannot exist inside RES oxide region.")
ACT.and(RES).output("14.PL2PR.bad3", "14.PL2PR.bad3: ACT cannot exist inside RES oxide region.")
PNSD.and(RES).output("14.PL2PR.bad4", "14.PL2PR.bad4: S/D Implant (NSD/PSD) is not allowed inside RES region.")

# === 4.15 PIP Capacitor Rules ===
POLY1_CAP.width(4.6.um).output("15.CAP.W1", "15.CAP.W1: POLY1 minimum width for PIP capacitor is 4.6um.")
POLY2_CAP.width(2.6.um).output("15.CAP.W2", "15.CAP.W2: POLY2 minimum width for PIP capacitor is 2.6um.")
POLY2_CAP.drc(width > 50.0.um).output("15.CAP.W2_max", "15.CAP.W2: POLY2 maximum width for PIP capacitor is 50um.")
POLY2_CAP.enclosing(POLY1_CAP, 1.0.um).output("15.CAP.E3", "15.CAP.E3: Extension of POLY2(CAP) to POLY1(CAP) is 1.0um.")
CAP.and(ACT).output("15.CAP.bad1", "15.CAP.bad1: Capacitor must be formed on field oxide.")

# === 4.16 PNP BJT Rules ===
# [오류 해결 완결] 면적단위를 .um2로 정합화하여 2x2, 5x5, 10x10 um 규격의 정사각형 에미터만 정확하게 추출하고 예외 처리합니다.
pnp_e_good_2  = PNP_E.drc(area == 4.0.um2 && perimeter == 8.0.um)
pnp_e_good_5  = PNP_E.drc(area == 25.0.um2 && perimeter == 20.0.um)
pnp_e_good_10 = PNP_E.drc(area == 100.0.um2 && perimeter == 40.0.um)
pnp_e_bad     = PNP_E.not(pnp_e_good_2.or(pnp_e_good_5).or(pnp_e_good_10))
pnp_e_bad.output("16.PNP.W1", "16.PNP.W1: Emitter square size must be exactly 2x2, 5x5, or 10x10 um.")

PNP_C.width(2.0.um).output("16.PNP.W2_C", "16.PNP.W2: Collector Ring width must be exactly 2.0um.")
PNP_B.width(2.0.um).output("16.PNP.W2_B", "16.PNP.W2: Base Ring width must be exactly 2.0um.")
PNP_E.separation(PNP_B, 4.5.um).output("16.PNP.S", "16.PNP.S: Space between Base and Emitter ACT must be exactly 4.5um.")
PNP_C.separation(ALLNWELL, 4.5.um).output("16.PNP.E1", "16.PNP.E1: Extension of ACT (Collector) to PWELL (NWELL edge) must be 4.5um.")
PNP_B.separation(ALLNWELL, 2.0.um).output("16.PNP.E2", "16.PNP.E2: Extension of ACT (Base) to NWELL edge must be 2.0um.")
PNP_C.separation(BJT, 4.5.um).output("16.PNP.E3", "16.PNP.E3: Extension of ACT (Collector) to BJT marker boundary must be >= 4.5um.")
ACT.and(BJT).enclosing(BJT_PSD.or(BJT_NSD), 1.0.um).output("16.PNP.E4", "16.PNP.E4: Extension of ACT to NSD/PSD implant layers inside BJT must be >= 1.0um.")

# === 4.17 NPN BJT Rules ===
# [오류 해결 완결] NPN 에미터 스퀘어 조건도 공식 면적 단위 메서드(.um2)로 보정 마감 완료
npn_e_good_2  = NPN_E.drc(area == 4.0.um2 && perimeter == 8.0.um)
npn_e_good_5  = NPN_E.drc(area == 25.0.um2 && perimeter == 20.0.um)
npn_e_good_10 = NPN_E.drc(area == 100.0.um2 && perimeter == 40.0.um)
npn_e_bad     = NPN_E.not(npn_e_good_2.or(npn_e_good_5).or(npn_e_good_10))
npn_e_bad.output("17.NPN.W1", "17.NPN.W1: Emitter square size must be exactly 2x2, 5x5, or 10x10 um.")

NPN_C.width(2.0.um).output("17.NPN.W2_C", "17.NPN.W2: Collector Ring width must be exactly 2.0um.")
NPN_B.width(2.0.um).output("17.NPN.W2_B", "17.NPN.W2: Base Ring width must be exactly 2.0um.")
NPN_E.separation(NPN_B, 4.5.um).output("17.NPN.S", "17.NPN.S: Space between Base and Emitter ACT must be exactly 4.5um.")
NPN_C.separation(ALLNWELL, 4.5.um).output("17.NPN.E1", "17.NPN.E1: Extension of ACT (Collector) to PWELL (NWELL edge) must be 4.5um.")
NPN_B.separation(ALLPWELL, 2.0.um).output("17.NPN.E2", "17.NPN.E2: Extension of ACT (Base) to PWELL edge must be 2.0um.")
NPN_C_WELL.enclosing(BJT, 1.0.um).output("17.NPN.E3", "17.NPN.E3: Extension of NWELL to BJT marker boundary must be >= 1.0um.")
ACT.and(BJT).enclosing(BJT_PSD.or(BJT_NSD), 1.0.um).output("17.NPN.E4", "17.NPN.E4: Extension of ACT to NSD/PSD implant layers inside BJT must be >= 1.0um.")

# === 4.20 Guard-ring & Latch-up Design Guidelines ===
ESD_NWELL.width(12.0.um).output("20.LU.W1", "20.LU.W1: Width of NWELL for ESD Latch-up protection must be >= 12.0um.")
ESD_TAP_ACT.width(10.0.um).output("20.LU.W2", "20.LU.W2: Width of dummy collector (N/P-type) must be >= 10.0um.")
ESD_TAP_PACT.separation(ESD_TAP_NWELL.interacting(ESD_GATE).and(ESD_TAP_NACT), 5.0.um).output("20.LU.S1", "20.LU.S1: Space of guard ring to dummy collector must be >= 5.0um.")
ESD_TAP_PACT.separation(ESD_TAP_NWELL.not(ESD_TAP_NWELL.interacting(ALLGATE)), 5.0.um).output("20.LU.S2", "20.LU.S2: Space of dummy collector to NWELL edge must be >= 5.0um.")
PMOS.and(ESD).separation(ESD_TAP_NACT, 1.0.um).output("20.LU.S3", "20.LU.S3: Space of P+ to N+ guard ring must be >= 1.0um.")
NMOS.and(ESD).separation(ESD_TAP_PACT, 1.0.um).output("20.LU.S4", "20.LU.S4: Space of N+ to P+ guard ring must be >= 1.0um.")
ESD_NWELL.enclosing(ESD_TAP_NACT, 2.0.um).output("20.LU.E1", "20.LU.E1: Extension of dummy collector to NWELL must be >= 2.0um.")
ESD_NWELL.enclosing(ESD_TAP_NACT, 2.0.um).output("20.LU.E2", "20.LU.E2: Extension of N+ guard ring to NWELL must be >= 2.0um.")

# === 4.21 Seal-Ring Rules ===
MET1.and(SEALRING_ZONE).width(12.0.um).output("21.SEAL.W_M1", "21.SEAL.W: Seal-Ring MET1 width must be exactly 12.0um.")
MET2.and(SEALRING_ZONE).width(12.0.um).output("21.SEAL.W_M2", "21.SEAL.W: Seal-Ring MET2 width must be exactly 12.0um.")
MET3.and(SEALRING_ZONE).width(12.0.um).output("21.SEAL.W_M3", "21.SEAL.W: Seal-Ring MET3 width must be exactly 12.0um.")

CONT.and(SEALRING_ZONE).width(4.1.um).output("21.SEAL.W_CONT", "21.SEAL: Seal-Ring Contact line width must be 4.1um.")
VIA1.and(SEALRING_ZONE).width(6.5.um).output("21.SEAL.W_VIA1", "21.SEAL: Seal-Ring VIA1 line width must be 6.5um.")
VIA2.and(SEALRING_ZONE).width(4.0.um).output("21.SEAL.W_VIA2", "21.SEAL: Seal-Ring VIA2 line width must be 4.0um.")

CHIPBOUNDARY.width(30.0.um).output("21.SEAL.Width_Total", "21.SEAL: Total Seal-Ring structure zone width must be exactly 30.0um.")
